# Copy to .env for local development. Never commit the real .env.

DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
SITE_URL=http://localhost:8000

# osu! OAuth application (https://osu.ppy.sh/home/account/edit -> OAuth).
# Callback URL must be exactly:  <SITE_URL>/auth/callback/
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Comma-separated osu! user ids who become site admins when they sign in.
ADMIN_OSU_IDS=

# Local only: lets you sign in as a fake player without osu! (ignored unless DEBUG=1).
DEV_LOGIN=1

# Production
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# ALLOWED_HOSTS=osutrivia.example
# TRUSTED_PROXY_COUNT=1
# ADMIN_URL=some-private-path/

# Legal page placeholders (leave unset to show the [BRACKETED] markers)
# CONTACT_EMAIL=hello@example.com
# JURISDICTION=State of X, Country Y
# EFFECTIVE_DATE=2026-12-01

# Set to 1 only if you have licensed Torus and added the font files (see README)
# USE_TORUS=0
